# A10 Hackathon Dashboard - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Dashboard Server Configuration
# =============================================================================

# GitHub OAuth (optional - leave blank to disable authentication)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Session secret for cookie encryption (generate with: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-random-32-byte-string-in-production"

# Enable/disable GitHub OAuth authentication
# Set to "true" to require login, "false" for open access
ENABLE_AUTH="false"

# Dashboard server port
PORT="8080"

# =============================================================================
# MCP Server Configuration
# =============================================================================

# API Token for MCP authentication (generate from dashboard)
MCP_API_TOKEN=""

# Require API token for MCP requests
# Set to "true" to require token, "false" for open access
REQUIRE_TOKEN="false"

# Dashboard URL for token validation
DASHBOARD_URL="http://localhost:8080"

# Docker configuration
SANDBOX_IMAGE="code-sandbox:latest"
SANDBOX_TIMEOUT="300"
MAX_SANDBOXES="10"

# =============================================================================
# Development Settings
# =============================================================================

# For local development, use these settings:
# ENABLE_AUTH="false"
# REQUIRE_TOKEN="false"
# This allows you to run without GitHub OAuth or API tokens

# =============================================================================
# Production Settings (Fly.io)
# =============================================================================

# For production deployment:
# ENABLE_AUTH="true"
# REQUIRE_TOKEN="true"
# GITHUB_CLIENT_ID="your_actual_client_id"
# GITHUB_CLIENT_SECRET="your_actual_client_secret"
# SESSION_SECRET="$(openssl rand -hex 32)"
# DASHBOARD_URL="https://your-app-name.fly.dev"

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# Database connection URL
# Format: postgresql://user:password@host:port/database
# 
# Local development (Docker):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/a10_hackathon"
#
# Production (Fly.io):
# DATABASE_URL="postgresql://user:password@host.internal:5432/dbname"
#
# Note: Fly.io sets DATABASE_URL automatically when you attach a database
