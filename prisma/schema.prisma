generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
  interface            = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_tokens {
  id          String    @id
  userId      String
  tokenHash   String    @unique
  name        String
  description String?
  active      Boolean   @default(true)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model container_crashes {
  id            String   @id
  containerId   String
  containerName String
  exitCode      Int
  signal        String?
  oomKilled     Boolean  @default(false)
  stdout        String?
  stderr        String?
  crashedAt     DateTime @default(now())

  @@index([containerId])
  @@index([crashedAt])
}

model container_metrics {
  id              String   @id
  containerId     String
  containerName   String
  status          String
  cpuPercent      Float
  memoryUsageMb   Float
  memoryLimitMb   Float
  memoryPercent   Float
  networkRxBytes  BigInt
  networkTxBytes  BigInt
  blockReadBytes  BigInt
  blockWriteBytes BigInt
  createdAt       DateTime @default(now())

  @@index([containerId, createdAt])
  @@index([createdAt])
}

model containers {
  id            String    @id
  containerId   String    @unique
  containerName String
  userId        String
  sandboxId     String    @unique
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  users         users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([sandboxId])
  @@index([userId])
}

model llm_reviews {
  id              String   @id
  userId          String?
  sandboxId       String
  source          String
  code            String
  codeLength      Int
  decision        String
  confidence      Float
  threatsDetected String[]
  reasoning       String?
  reviewTime      Float
  modelUsed       String
  createdAt       DateTime @default(now())
  users           users?   @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([decision])
  @@index([sandboxId])
  @@index([userId])
}

model mcp_requests {
  id            String   @id
  userId        String?
  tool          String
  status        String
  sandboxId     String?
  codeLength    Int?
  url           String?
  resultPreview String?
  errorMessage  String?
  executionTime Float?
  createdAt     DateTime @default(now())
  users         users?   @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([sandboxId])
  @@index([userId])
}

model ml_predictions {
  id            String   @id
  userId        String?
  containerId   String
  containerName String
  prediction    String
  confidence    Float
  samples       Int
  duration      Float
  features      Json
  createdAt     DateTime @default(now())
  users         users?   @relation(fields: [userId], references: [id])

  @@index([containerId])
  @@index([createdAt])
  @@index([prediction])
  @@index([userId])
}

model system_metrics {
  id                String   @id
  totalContainers   Int
  runningContainers Int
  totalCpuPercent   Float
  totalMemoryMb     Float
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model users {
  id             String           @id
  githubId       String           @unique
  username       String           @unique
  email          String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  api_tokens     api_tokens[]
  containers     containers[]
  llm_reviews    llm_reviews[]
  mcp_requests   mcp_requests[]
  ml_predictions ml_predictions[]
}
