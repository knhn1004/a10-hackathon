# Local Development Environment Variables
# Copy this to .env for local development

# =============================================================================
# GitHub OAuth (Local Development)
# =============================================================================
# Create OAuth app at: https://github.com/settings/developers
# Homepage URL: http://localhost:8080
# Callback URL: http://localhost:8080/auth/callback

GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# Generate with: openssl rand -hex 32
SESSION_SECRET="your_random_32_byte_string_here"

# Enable authentication (set to "false" to disable)
ENABLE_AUTH="true"

# Dashboard port
PORT="8080"

# =============================================================================
# PostgreSQL Database (Remote)
# =============================================================================
# Get from Neon.tech, Supabase, Railway, or Fly.io
# Format: postgresql+asyncpg://user:pass@host:port/database

DATABASE_URL="postgresql+asyncpg://your_connection_string_here"

# =============================================================================
# MCP Server (User's Local Config - NOT dashboard server!)
# =============================================================================
# These are for YOUR local MCP server, NOT the dashboard
# You'll set these after generating a token from the dashboard

# Your personal API token (generate from dashboard after login)
MCP_API_TOKEN=""

# Enable token requirement
REQUIRE_TOKEN="false"

# Dashboard URL (where to validate tokens)
DASHBOARD_URL="http://localhost:8080"

# =============================================================================
# Quick Setup Instructions
# =============================================================================
# 
# 1. Create GitHub OAuth App:
#    - Go to: https://github.com/settings/developers
#    - New OAuth App
#    - Homepage: http://localhost:8080
#    - Callback: http://localhost:8080/auth/callback
#    - Copy Client ID and Client Secret to above
#
# 2. Generate Session Secret:
#    $ openssl rand -hex 32
#    - Copy to SESSION_SECRET above
#
# 3. Get PostgreSQL Database:
#    - Sign up at: https://console.neon.tech
#    - Create project
#    - Copy connection string
#    - Add +asyncpg after postgresql://
#    - Paste to DATABASE_URL above
#
# 4. Save this file as .env:
#    $ cp .env.local.example .env
#
# 5. Run setup:
#    $ ./setup_remote_db.sh
#
# 6. Start dashboard:
#    $ poetry run python dashboard_server.py
#
# 7. Visit: http://localhost:8080
#
